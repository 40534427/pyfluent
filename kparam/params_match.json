      "环境温度_T": {
        "值": 285.91,
        "单位": "K",
        "说明": "T = P/(ρR) 自动计算",
        "可调": false
      },
      "声速_c0": {
        "值": 338.97,
        "单位": "m/s",
        "说明": "c0 = sqrt(γP/ρ) 自动计算",
        "可调": false
      },
      "来流马赫数": {
        "值": 0.649,
        "单位": "",
